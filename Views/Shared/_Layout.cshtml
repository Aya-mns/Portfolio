<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aya Salem Portfolio</title>
@*     <title>@ViewData["Title"]Aya Salem Portfolio</title>
 *@    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/CustomCssSite.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/Portfolio.styles.css" asp-append-version="true" /> *@
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Michroma&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
    
    <link rel="stylesheet" type='text/css' href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
          


</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index"> DevPortfolio</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav ">
                        <li class="nav-item">
                            <a class="nav-link active text-light" @* asp-controller="Home" asp-action="Index" *@ href="#"><i class="fa-solid fa-house"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" @* asp-controller="Home" asp-action="Privacy" *@ href="#"><i class="fa-solid fa-circle-info"></i> About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="#"><i class="fa-solid fa-code-branch"></i> Skills</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light"  href="#"><i class="fa-solid fa-laptop"></i> Projects</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="#Contact"><i class="fa-solid fa-address-book"></i> Contact</a>
                        </li>
                    </ul>
                </div>
                <a href="https://github.com/Aya-mns" target="_blank" class="GitHubBtn"> <i class="fa-brands fa-github"></i></a>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted" style="margin-top:50px; margin-bottom:40px;">
        <hr />
        <section id="Contact">
        <div class="container">
            &copy; 2026 - Portfolio - <a asp-area="" asp-controller="Home" asp-action="Privacy">Aya Salem</a>
        </div>
        </section>
    </footer>


    <script>
        const navLinks = document.querySelectorAll(".navbar .nav-link");

        navLinks.forEach(link => {
            link.addEventListener("click", function () {

                navLinks.forEach(l => l.classList.remove("active"));

                this.classList.add("active");

            });
        });
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)


</body>
</html>
